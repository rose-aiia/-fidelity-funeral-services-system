PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funeral_service_dev?schema=public"
JWT_SECRET="replace_with_secure_local_secret"
JWT_EXPIRES_IN="7d"
# Must match the frontend dev-server origin so CORS/cookies work.
# If you run the real API, point the frontend's API_PROXY_TARGET at http://localhost:4000.
FRONTEND_ORIGIN="http://localhost:5173"
