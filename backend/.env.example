PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/funeral_service_dev?schema=public"
JWT_SECRET="replace_with_secure_local_secret"
JWT_EXPIRES_IN="7d"
# Must match the frontend dev-server origin so CORS/cookies work.
# If you run the real API, point the frontend's API_PROXY_TARGET at http://localhost:4000.
FRONTEND_ORIGIN="http://localhost:5173"

# --- SMS / WhatsApp alerts ---
# Nothing is sent unless ALERTS_ENABLED=true. ALERTS_MODE=log prints messages instead of calling a provider.
ALERTS_ENABLED="false"
ALERTS_MODE="log"
# Interim shared secret for POST /api/alerts/dispatch and GET /api/alerts/outbox (send as "Authorization: Bearer ...").
ALERTS_API_TOKEN=""
PUBLIC_BASE_URL="http://localhost:4000"
# SMS: Africa's Talking is used when its key and username are set, otherwise Twilio, otherwise log.
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_FROM=""
AFRICASTALKING_CALLBACK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# WhatsApp: a company-owned number paired once by an admin (Baileys, as in Kuwana). Run the bridge process
# (npm run whatsapp). This is an unofficial client: use a dedicated number and keep volumes low.
# Shared secret for the bridge's localhost control server; the bridge refuses to start without it.
WHATSAPP_BRIDGE_SECRET=""
WHATSAPP_INTERNAL_PORT="3003"
# Persistent, private directory holding the paired session. Never commit it or deploy over it.
WHATSAPP_SESSION_DIR=".whatsapp-session"
# Pacing between sends (milliseconds): minimum gap plus random jitter.
WHATSAPP_MIN_INTERVAL_MS="1500"
WHATSAPP_JITTER_MS="1000"

# --- Job queue (pg-boss, in its own schema of DATABASE_URL) ---
PGBOSS_SCHEMA="pgboss"
DATABASE_POOL_MAX="5"
