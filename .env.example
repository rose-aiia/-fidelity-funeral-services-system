# 'mock' (default) serves the built-in sample data. 'live' calls the backend API.
VITE_API_MODE=mock

# Base URL of the API. A relative URL goes through the Vite dev-server proxy (see API_PROXY_TARGET),
# which avoids CORS in development. In production use the API's absolute URL or a same-origin path.
VITE_API_BASE_URL=/api

# Dev server only: where requests to /api are forwarded.
API_PROXY_TARGET=http://localhost:8080
